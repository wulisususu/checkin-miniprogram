.record-page {
  padding: 24rpx 24rpx 60rpx;
  background: #f2f2f7;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ── Header ── */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1c1c1e;
  letter-spacing: -0.5rpx;
}

.clear-btn {
  color: #e64340;
  border-color: #e64340;
  font-size: 24rpx;
}

/* ── Admin user selector ── */
.user-selector {
  display: flex;
  align-items: center;
  background: #e8f7ec;
  border-radius: 32rpx;
  padding: 10rpx 16rpx 10rpx 22rpx;
  border: 2rpx solid #c8e8d0;
}

.selector-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f8a38;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  opacity: 0.55;
}

/* ── Calendar card ── */
.month-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 20rpx 28rpx;
  box-shadow: 0 4rpx 28rpx rgba(0, 0, 0, 0.07);
  margin-bottom: 20rpx;
}

/* Nav row */
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.nav-btn {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f2f2f7;
  flex-shrink: 0;
}

.nav-btn:active {
  background: #e5e5ea;
  opacity: 0.75;
}

.nav-icon {
  font-size: 38rpx;
  color: #1c1c1e;
  font-weight: 600;
  line-height: 1;
}

/* Title/picker */
.cal-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.cal-title-wrap:active {
  opacity: 0.6;
}

.cal-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #1c1c1e;
  letter-spacing: -0.5rpx;
}

.down-icon {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.45;
  margin-top: 2rpx;
}

/* Subtitle */
.cal-subtitle {
  font-size: 24rpx;
  color: #8e8e93;
  text-align: center;
  margin-bottom: 22rpx;
  font-weight: 400;
}

/* Week row */
.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.week-label {
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
  padding: 6rpx 0;
}

/* Calendar grid */
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  row-gap: 4rpx;
}

.cal-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 6rpx;
}

.cal-cell:active {
  opacity: 0.55;
}

.cell-muted {
  opacity: 0.22;
}

/* Day circle */
.day-circle {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cell-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1;
}

/* Today: green accent number */
.circle-today .cell-num {
  color: #2ba245;
  font-weight: 800;
}

/* Selected: dark fill */
.circle-sel {
  background: #1c1c1e;
}

.circle-sel .cell-num {
  color: #ffffff;
}

/* Today + selected: green fill */
.circle-today-sel {
  background: #2ba245;
}

.circle-today-sel .cell-num {
  color: #ffffff;
}

/* Check-in dot */
.cell-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #2ba245;
  margin-top: 4rpx;
}

.dot-light {
  background: rgba(255, 255, 255, 0.75);
}

/* ── Day section ── */
.day-section {
  padding: 0 4rpx;
}

.day-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.empty-text {
  text-align: center;
  color: #8e8e93;
  font-size: 28rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

/* ── Record card ── */
.record-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 16rpx;
}

.record-time {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 10rpx;
}

.record-location {
  font-size: 24rpx;
  color: #636366;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.record-photo {
  width: 100%;
  height: 300rpx;
  border-radius: 14rpx;
  margin-top: 6rpx;
  background: #f2f2f7;
}

/* ── Address row (tappable → map) ── */
.record-addr-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-addr-row:active {
  opacity: 0.55;
}

.record-location {
  flex: 1;
  font-size: 24rpx;
  color: #636366;
  line-height: 1.5;
}

.addr-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
  margin-left: 8rpx;
  font-weight: 400;
  line-height: 1;
}

/* ── Map popup ── */
.map-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.map-modal {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.map-modal-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #d1d1d6;
  margin: 16rpx auto 0;
}

.map-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 28rpx 22rpx;
}

.map-modal-info {
  flex: 1;
}

.map-modal-time {
  display: block;
  font-size: 24rpx;
  color: #8e8e93;
  margin-bottom: 6rpx;
}

.map-modal-addr {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
  line-height: 1.4;
}

.map-close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f2f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #636366;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.map-close-btn:active {
  background: #e5e5ea;
}

.map-view {
  width: 100%;
  height: 520rpx;
  display: block;
}
