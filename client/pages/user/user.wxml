<view class="user-page">
  <view class="avatar-section">
    <image src="{{avator_path}}" class="avator" mode="aspectFill" bindtap="changeAvator"></image>
    <text class="avatar-hint">点击更换头像</text>
  </view>

  <view class="info-card">
    <view class="info-row">
      <text class="info-label">手机号</text>
      <text class="info-value {{phone ? '' : 'unset'}}">{{phone || '未授权'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">账号 ID</text>
      <text class="info-value uid">{{shortId}}</text>
    </view>
  </view>

  <view class="actions">
    <button
      wx:if="{{!phone}}"
      class="action-btn primary"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{phoneLoading}}"
      disabled="{{phoneLoading}}"
    >授权手机号</button>
    <button
      wx:else
      class="action-btn secondary"
      open-type="getPhoneNumber"
      bindgetphonenumber="onGetPhoneNumber"
      loading="{{phoneLoading}}"
      disabled="{{phoneLoading}}"
    >更换手机号</button>
  </view>
</view>
