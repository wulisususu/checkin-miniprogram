.user-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 60rpx;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 32rpx;
  background: #fff;
}

.avator {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #e0f2e7;
}

.avatar-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #aaa;
}

.info-card {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #1f1f1f;
  font-weight: 500;
}

.info-value.unset {
  color: #bbb;
}

.info-value.uid {
  font-family: monospace;
  font-size: 24rpx;
  color: #999;
}

.actions {
  margin: 32rpx 28rpx 0;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #2ba245, #1f8a38);
  color: #fff;
  box-shadow: 0 6rpx 18rpx rgba(43, 162, 69, 0.3);
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #555;
}
