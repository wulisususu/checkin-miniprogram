.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #e8f5e9 0%, #ffffff 60%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  margin-bottom: 36rpx;
  box-shadow: 0 8rpx 24rpx rgba(43, 162, 69, 0.2);
}

.app-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 14rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 60rpx;
}

.login-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nickname-row {
  width: 600rpx;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 88rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.input-label {
  font-size: 28rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.nickname-input {
  flex: 1;
  font-size: 28rpx;
  color: #1f1f1f;
  height: 88rpx;
  line-height: 88rpx;
}

.input-placeholder {
  color: #bbb;
  font-size: 26rpx;
}

.phone-btn {
  width: 600rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #2ba245, #1f8a38);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(43, 162, 69, 0.35);
}

.privacy-tip {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #ccc;
}
