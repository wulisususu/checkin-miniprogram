.page_check_hd {
  padding: 28rpx 20rpx 8rpx;
}
.page_check_title {
  font-size: 20px;
  text-align: center;
  font-weight: 700;
  letter-spacing: 1px;
  color: #111;
}
.check_image_bd {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 22rpx;
}
.check_image {
  width: 640rpx;
  height: 360rpx;
  border-radius: 20rpx;
  background: #f5f5f5;
}
.button-sp-area {
  margin: 0 auto;
  padding-top: 18px;
  width: 60%;
}
.primary-btn {
  background: linear-gradient(135deg, #2ba245, #1f8a38);
  color: #fff;
  border: none;
}
.success-btn {
  background: linear-gradient(135deg, #1976d2, #0d47a1);
  color: #fff;
  border: none;
}
.map_card {
  margin: 28rpx 28rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.08);
}
.check_map {
  width: 100%;
  height: 560rpx;
}
.map_meta {
  padding: 20rpx 24rpx 24rpx;
}
.map_status {
  font-size: 16px;
  font-weight: 700;
  color: #1f1f1f;
}
.map_subtitle {
  margin-top: 8rpx;
  font-size: 13px;
  color: #666;
}
.btn_footer {
  margin-bottom: 40px;
}