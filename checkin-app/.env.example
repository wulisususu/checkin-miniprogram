NODE_ENV=development
PORT=3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=checkin_prod
DB_USER=checkin_user
DB_PASSWORD=replace_me
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=https://YOUR_DOMAIN/checkin-api
WX_APPID=your_miniprogram_appid
WX_APPSECRET=your_miniprogram_appsecret
ADMIN_PHONE=YOUR_ADMIN_PHONE

# Empty or * keeps current compatibility (all browser origins allowed).
# Set a comma-separated allowlist when exposing browser/H5 clients.
CORS_ORIGINS=

# Applies to /api except /api/health. Defaults are intentionally generous
# for the current small private deployment.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
